# --- API Key Authentication (RBAC) ---
# Format: "key:role,key:role" — roles: admin, write, read
# If empty, authentication is DISABLED (dev mode).
# Example: API_KEYS=sk-admin-abc123:admin,sk-write-xyz789:write,sk-read-def456:read
API_KEYS=

# --- Rate Limiting ---
# Sliding-window rate limit per API key (or IP if no key)
